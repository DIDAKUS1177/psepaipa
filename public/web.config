<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS (Plesk Windows). La raíz del sitio debe ser esta carpeta public/:
     src/, lib/, config/ y config.local.php quedan fuera de la web.
     La redirección de HTTP a HTTPS se activa en Plesk (Hosting > "Redirección
     301 permanente de HTTP a HTTPS"), no aquí, para no depender del módulo
     URL Rewrite. -->
<configuration>
    <system.webServer>
        <defaultDocument enabled="true">
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <remove name="X-Content-Type-Options" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <remove name="Referrer-Policy" />
                <add name="Referrer-Policy" value="same-origin" />
                <remove name="X-Frame-Options" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <remove name="Strict-Transport-Security" />
                <add name="Strict-Transport-Security" value="max-age=31536000" />
                <remove name="Permissions-Policy" />
                <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
                <remove name="Content-Security-Policy" />
                <add name="Content-Security-Policy" value="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; form-action 'self' https://checkout.avalpaycenter.com https://checkout.test.avalpaycenter.com; base-uri 'self'" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
